{
  "name": "taro-shadcn-mobx-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Taro scaffold for Web & mini-app, based on TypeScript, Vite, React, Tailwind CSS & Shadcn UI.",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@vant/area-data": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "event-target-shim": "^6.0.2",
    "koajax": "^3.3.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react-taro": "^1.5.2",
    "mobx": "^6.16.1",
    "mobx-github": "^0.7.1",
    "mobx-i18n": "^0.7.9",
    "mobx-react": "^9.2.2",
    "mobx-restful": "^2.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "taro-fetch-polyfill": "^0.5.8",
    "web-utility": "^4.8.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.21",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-idea2app-tsx": "^0.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxc-transform-react": "^0.157.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rolldown": "1.2.15",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vite": "8.3.5",
    "vite-plugin-taro": "0.8.4"
  },
  "resolutions": {
    "@types/react": "$@types/react",
    "idb-keyval": "npm:taro-idb-keyval"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "prettier": {
    "trailingComma": "none",
    "arrowParens": "avoid",
    "singleQuote": true,
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "lint-staged": {
    "*.{md,js,ts,tsx,json,yml}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev-wx": "cross-env NODE_ENV=development VITE_VPT_TARGET=wx vite",
    "dev-h5": "cross-env NODE_ENV=development VITE_VPT_TARGET=h5 vite",
    "build-wx": "cross-env NODE_ENV=production VITE_VPT_TARGET=wx vite build",
    "build-h5": "cross-env NODE_ENV=production VITE_VPT_TARGET=h5 vite build",
    "preview-h5": "cross-env NODE_ENV=production VITE_VPT_TARGET=h5 vite preview --outDir dist/h5",
    "test": "lint-staged  &&  tsc --noEmit"
  }
}
